{# import "layout.jx" as Layout #}
{# def #}
{% set people = [{"name": "Ana", "age": 31}, {"name": "bruno", "age": 24}, {"name": "Cira", "age": 45}] %}
<Layout title="Filtros y tests">
  <p>La columna de la izquierda es el código; la de la derecha, lo que devuelve el runtime de minijx.</p>
  <table class="table code-table">
    <thead><tr><th>Expresión</th><th>Resultado</th></tr></thead>
    <tbody>
      <tr><td><code>{% raw %}{{ "hola mundo" | title }}{% endraw %}</code></td><td>{{ "hola mundo" | title }}</td></tr>
      <tr><td><code>{% raw %}{{ "  espacios  " | trim | upper }}{% endraw %}</code></td><td>{{ "  espacios  " | trim | upper }}</td></tr>
      <tr><td><code>{% raw %}{{ "<b>negrita</b>" | e }}{% endraw %}</code></td><td>{{ "<b>negrita</b>" | e }}</td></tr>
      <tr><td><code>{% raw %}{{ "<b>negrita</b>" }}{% endraw %}</code></td><td>{{ "<b>negrita</b>" }}</td></tr>
      <tr><td><code>{% raw %}{{ "<p>Hola <i>tú</i></p>" | striptags }}{% endraw %}</code></td><td>{{ "<p>Hola <i>tú</i></p>" | striptags }}</td></tr>
      <tr><td><code>{% raw %}{{ people | map(attribute="name") | join(", ") }}{% endraw %}</code></td><td>{{ people | map(attribute="name") | join(", ") }}</td></tr>
      <tr><td><code>{% raw %}{{ people | sort(attribute="age", reverse=true) | first }}{% endraw %}</code></td><td>{{ people | sort(attribute="age", reverse=true) | first }}</td></tr>
      <tr><td><code>{% raw %}{{ people | selectattr("age", "gt", 30) | list | length }}{% endraw %}</code></td><td>{{ people | selectattr("age", "gt", 30) | list | length }}</td></tr>
      <tr><td><code>{% raw %}{{ people | max(attribute="age") }}{% endraw %}</code></td><td>{{ people | max(attribute="age") }}</td></tr>
      <tr><td><code>{% raw %}{{ people | sum(attribute="age") }}{% endraw %}</code></td><td>{{ people | sum(attribute="age") }}</td></tr>
      <tr><td><code>{% raw %}{{ range(10) | batch(4, "·") | list }}{% endraw %}</code></td><td>{{ range(10) | batch(4, "·") | list }}</td></tr>
      <tr><td><code>{% raw %}{{ range(7) | slice(3) | list }}{% endraw %}</code></td><td>{{ range(7) | slice(3) | list }}</td></tr>
      <tr><td><code>{% raw %}{{ [3, 1, 3, 2] | unique | list }}{% endraw %}</code></td><td>{{ [3, 1, 3, 2] | unique | list }}</td></tr>
      <tr><td><code>{% raw %}{{ {"b": 2, "a": 1} | dictsort }}{% endraw %}</code></td><td>{{ {"b": 2, "a": 1} | dictsort }}</td></tr>
      <tr><td><code>{% raw %}{{ 1234567 | filesizeformat }}{% endraw %}</code></td><td>{{ 1234567 | filesizeformat }}</td></tr>
      <tr><td><code>{% raw %}{{ 3.14159 | round(2) }}{% endraw %}</code></td><td>{{ 3.14159 | round(2) }}</td></tr>
      <tr><td><code>{% raw %}{{ "42" | int + 1 }}{% endraw %}</code></td><td>{{ "42" | int + 1 }}</td></tr>
      <tr><td><code>{% raw %}{{ "%s tiene %d años" | format("Ana", 31) }}{% endraw %}</code></td><td>{{ "%s tiene %d años" | format("Ana", 31) }}</td></tr>
      <tr><td><code>{% raw %}{{ "una frase bastante larga para cortar" | truncate(20) }}{% endraw %}</code></td><td>{{ "una frase bastante larga para cortar" | truncate(20) }}</td></tr>
      <tr><td><code>{% raw %}{{ {"q": "a b", "n": 1} | urlencode }}{% endraw %}</code></td><td>{{ {"q": "a b", "n": 1} | urlencode }}</td></tr>
      <tr><td><code>{% raw %}{{ {"a": [1, "<x>"]} | tojson }}{% endraw %}</code></td><td>{{ {"a": [1, "<x>"]} | tojson }}</td></tr>
      <tr><td><code>{% raw %}{{ "abc" | reverse }}{% endraw %}</code></td><td>{{ "abc" | reverse }}</td></tr>
      <tr><td><code>{% raw %}{{ 7 is odd }} {{ 7 is divisibleby 3 }} {{ "x" is string }}{% endraw %}</code></td><td>{{ 7 is odd }} {{ 7 is divisibleby 3 }} {{ "x" is string }}</td></tr>
      <tr><td><code>{% raw %}{{ nada is defined }}{% endraw %}</code></td><td>{{ nada is defined }}</td></tr>
      <tr><td><code>{% raw %}{{ "a" ~ 1 ~ none }}{% endraw %}</code></td><td>{{ "a" ~ 1 ~ none }}</td></tr>
      <tr>
        <td><code>{% raw %}{% filter upper | replace("A", "4") %}banana{% endfilter %}{% endraw %}</code></td>
        <td>{% filter upper | replace("A", "4") %}banana{% endfilter %}</td>
      </tr>
    </tbody>
  </table>
</Layout>
